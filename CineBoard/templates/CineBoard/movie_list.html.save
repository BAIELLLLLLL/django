<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Список фильмов</title>
</head>
<body>
    <h1>Список фильмов</h1>

    {% for movie in movies %}
        <h2>{{ movie.title }}</h2>
        <p>{{ movie.description }}</p>
        <p>Год выпуска: {{ movie.release_year }}</p>
        <p>Жанр: {{ movie.genre }}</p>
        <hr>
    {% empty %}
        <p>Пока фильмов нет.</p>
    {% endfor %}
</body>
</html>


